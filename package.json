{
  "name": "qrseva-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:sales": "npm run dev --workspace=sales-dashboard",
    "dev:admin": "npm run dev --workspace=admin-dashboard",
    "dev:customer": "npm run dev --workspace=customer-app",
    "dev:landing": "npm run dev --workspace=landing-page",
